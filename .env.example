# Public URL of the deployed site (no trailing slash), e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (https://resend.com). Without a key the form reports an error.
RESEND_API_KEY=re_xxxxxxxx
# Optional: sender on a domain you verified in Resend, and the inbox to deliver to.
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
# CONTACT_TO_EMAIL=you@example.com

# Optional: lets the GitHub card list your pinned repositories.
GITHUB_TOKEN=github_pat_xxxxxxxx
